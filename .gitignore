# Working material that is not part of the published repository.
# `default-workspace/` is the DSH workspace directory: a scratch tree holding session
# media, research dumps and an extracted DSH build. It must never be committed.
/default-workspace/

# Other working trees can live beside this one, and they are not part of this
# repository: a sibling package directory is ignored by pattern rather than by name.
/dsh-plugin-*/

# Installed tooling.
node_modules/
pnpm-debug.log*

# Editor and OS noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local scratch output.
.tmp-*
