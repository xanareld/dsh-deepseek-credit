{
  "name": "dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeek Harness plugins: sidebar cost, peak/off-peak rate window and remaining API credit.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xanareld/dsh-deepseek-credit.git"
  },
  "homepage": "https://github.com/xanareld/dsh-deepseek-credit#readme",
  "bugs": {
    "url": "https://github.com/xanareld/dsh-deepseek-credit/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "metrics": "node scripts/metrics.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm test && pnpm metrics"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
